[Unit]
Description=pi-web multiuse (corporate AI chat for the buhgalter company)
Documentation=https://github.com/ent-ini/pers-pi-web
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=buhgalter
Group=buhgalter
WorkingDirectory=/opt/pi-web-multi
# The script waits for the tailscale address of the host, starts the control
# plane and the worker manager, and recreates the control plane when the
# published port did not survive the boot. A plain `docker compose up -d` is
# not enough: after a failed bind at boot the container runs without the
# published port and the reverse proxy answers 502.
ExecStart=/usr/local/bin/pi-web-multi-up.sh
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
